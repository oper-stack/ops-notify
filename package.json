{
  "name": "operstack-ops-notify",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Sales inbox and daily digest to Telegram for OperStack",
  "scripts": {
    "mail": "node notify-mail.mjs",
    "mail:dry": "node notify-mail.mjs --dry-run",
    "digest": "node digest.mjs",
    "digest:dry": "node digest.mjs --dry-run",
    "test": "node test-letter.mjs && node test-queue.mjs",
    "verify:funnel": "node verify-funnel.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@operstack/audit": "^0.19.0",
    "imapflow": "^1.0.190",
    "nodemailer": "^10.0.8"
  }
}
